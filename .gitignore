# Build output
/out/
/artifacts/
*.wim
*.iso
*.vhdx
*.esd

# Lab / scratch
/lab/
C:/HDTLab/

# Git worktrees live inside the repo so they share the same drive and tooling.
# Their contents are checkouts of other branches - tracked by their own worktree,
# never staged into this one.
/.claude/worktrees/

# The deployment share secret (DESIGN 6.3). Set-HDTShareCredential writes it,
# it is obfuscated rather than encrypted, and it never belongs in git.
Control/share-credential.json
**/Control/share-credential.json

# Credentials never live in this repository (PROJECT.md, 'Remote lab and CI
# host'). MS-A2's is at ..\LabSystemCenterInHome\.secrets\ms-a2.xml and is read
# from there at runtime. This entry is a net, not a location: a secret that
# needs it is already somewhere it was told not to be.
.secrets/

# Test results
/tests/**/TestResults/
*.trx
coverage*.xml
testResults*.xml

# .NET
bin/
obj/
*.user

# PowerShell
*.psd1.bak

# OS
Thumbs.db
desktop.ini
.DS_Store

# The module bundle: generated by ./build.ps1 -Task bundle, never committed.
# Hephaestus.psm1 ignores it whenever a source is newer, so it is a cache and
# nothing else.
src/Hephaestus/Hephaestus.bundle.ps1
