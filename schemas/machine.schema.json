{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hephaestus/schemas/machine.schema.json",
  "title": "HDT per-machine override",
  "type": "object",
  "required": ["schemaVersion", "variables"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "variables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^HDT[A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "boolean", "integer", "number", "array"] }
    }
  }
}
