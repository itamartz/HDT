{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hephaestus/schemas/app.schema.json",
  "title": "HDT app.yaml",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "install"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "uninstall": {
      "type": "string",
      "minLength": 1
    },
    "successCodes": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "rebootCodes": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "runIn": {
      "enum": [
        "WinPE",
        "FullOS",
        "Any"
      ]
    },
    "detect": {
      "$ref": "#/definitions/detect"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "folder": {
      "type": "string",
      "description": "Which folder the console draws this under. A label for the window only - the engine ignores it.",
      "pattern": "^[^\\\\/]+(\\\\[^\\\\/]+)*$"
    }
  },
  "definitions": {
    "detect": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "$ref": "#/definitions/detectMsiProduct"
        },
        {
          "$ref": "#/definitions/detectFile"
        },
        {
          "$ref": "#/definitions/detectRegistry"
        },
        {
          "$ref": "#/definitions/detectScript"
        }
      ]
    },
    "detectMsiProduct": {
      "type": "object",
      "required": [
        "type",
        "productCode"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "msiProduct"
        },
        "productCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "detectFile": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "detectRegistry": {
      "type": "object",
      "required": [
        "type",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "registry"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string"
        }
      }
    },
    "detectScript": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "script"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
