{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hephaestus/schemas/os.schema.json",
  "title": "HDT os.yaml",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "type", "sourcePath", "images"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": { "type": "string", "enum": ["wim", "ffu"] },
    "architecture": { "type": "string", "enum": ["x86", "x64", "arm64"] },
    "sourcePath": { "type": "string", "minLength": 1 },
    "importedUtc": { "type": "string", "minLength": 1 },
    "defaultIndex": { "type": "integer", "minimum": 1 },
    "images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/image" }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["index", "name"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "edition": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "version": { "type": "string" }
      }
    }
  }
}
